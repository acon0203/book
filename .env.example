# 연재서재 (Book Studio) 환경 변수 설정 템플릿
# 본 파일을 복사하여 .env 파일을 생성한 뒤 필요한 값을 설정하세요.
# (모든 API 키는 프론트엔드 서재 관리 화면에서 직접 입력할 수도 있습니다.)

# 1. Google AI Studio (무료 API 키 발급: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 2. 외부 AI 제공자 (선택 사항)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 3. Firebase 프로젝트 설정 (선택: 커스텀 Firebase 프로젝트 연결 시)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
